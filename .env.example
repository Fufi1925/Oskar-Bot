# ╔══════════════════════════════════════════════════════════════╗
# ║           University Bot — Environment Configuration         ║
# ║                                                              ║
# ║  Kopiere diese Datei als .env und fülle ALLE Werte aus.     ║
# ║  Auf Railway: Trage diese Werte unter Variables ein.        ║
# ╚══════════════════════════════════════════════════════════════╝


# ═══ DISCORD BOT ═══════════════════════════════════════════════
# Dein Discord Bot Token (von https://discord.com/developers/applications)
TOKEN=DEIN_DISCORD_BOT_TOKEN_HIER

# Dein Discord User ID (und andere Owner, kommagetrennt)
OWNER_IDS=DEINE_DISCORD_USER_ID

# Bot Name (wird überall angezeigt)
brand_name=University Bot

# ═══ LAVALINK (Musik) ══════════════════════════════════════════
# Öffentlicher Lavalink-Server oder eigener
# Kostenlos: lavalink.jirayu.net (Port 13592, Passwort: youshallnotpass, secure: false)
LAVALINK_HOST=lavalink.jirayu.net
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_PORT=13592

# ═══ API + DASHBOARD ═══════════════════════════════════════════
# API aktivieren (true = Dashboard ist erreichbar)
API_ENABLED=true

# Geteiltes Secret zwischen Bot-API und Dashboard (frei wählbar, aber stark!)
DASHBOARD_API_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_abc123xyz

# Extra CORS Origins (kommagetrennt, optional)
CORS_ORIGINS=

# ═══ DISCORD OAUTH2 (für Dashboard Login) ══════════════════════
# Erstelle eine OAuth2 App unter:
# https://discord.com/developers/applications → YOUR APP → OAuth2
# Redirect URL: https://DEINE-RAILWAY-URL.up.railway.app/api/auth/callback/discord
DISCORD_CLIENT_ID=DEINE_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=DEIN_DISCORD_CLIENT_SECRET

# ═══ NEXTAUTH (Dashboard Session) ═════════════════════════════
# Auf Railway: https://DEIN-SERVICE.up.railway.app
# Lokal: http://localhost:8000
NEXTAUTH_URL=http://localhost:8000

# Generiere ein langes Random Secret: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=GENERIERE_EIN_LANGEN_RANDOM_STRING

# ═══ DASHBOARD BRANDING ════════════════════════════════════════
# Discord User IDs die Admin-Zugang im Dashboard haben (kommagetrennt)
NEXT_PUBLIC_ADMIN_IDS=DEINE_DISCORD_USER_ID

# Angezeigter Name im Dashboard
NEXT_PUBLIC_BRAND_NAME=University Bot
NEXT_PUBLIC_BRAND_NAME_WORD=UB

# ═══ WEBHOOKS (optional) ══════════════════════════════════════
WEBHOOK_URL=
CMD_WEBHOOK_URL=

# ═══ EMOJI SYNC ════════════════════════════════════════════════
EMOJI_SYNC=false
