# ╔══════════════════════════════════════════════════════════════╗
# ║           University Bot — Environment Configuration         ║
# ║                                                              ║
# ║  Kopiere diese Datei als .env und fülle ALLE Werte aus.     ║
# ║  Auf Railway: Trage diese Werte unter Variables ein.        ║
# ╚══════════════════════════════════════════════════════════════╝


# ═══ DISCORD BOT ═══════════════════════════════════════════════
# Dein Discord Bot Token (von https://discord.com/developers/applications)
TOKEN=DEIN_DISCORD_BOT_TOKEN_HIER

# Dein Discord User ID (und andere Owner, kommagetrennt)
OWNER_IDS=DEINE_DISCORD_USER_ID

# Bot Name (wird überall angezeigt)
brand_name=University Bot

# ═══ LAVALINK (Musik) ══════════════════════════════════════════
# Öffentlicher Lavalink-Server oder eigener
# Kostenlos: lavalink.jirayu.net (Port 13592, Passwort: youshallnotpass, secure: false)
LAVALINK_HOST=lavalink.jirayu.net
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_PORT=13592

# ═══ API + DASHBOARD ═══════════════════════════════════════════
# API aktivieren (true = Dashboard ist erreichbar)
API_ENABLED=true

# Geteiltes Secret zwischen Bot-API und Dashboard (frei wählbar, aber stark!)
#
# ⚠️ WICHTIG: Setze diesen Wert NIEMALS als NEXT_PUBLIC_DASHBOARD_API_KEY.
# Alles mit NEXT_PUBLIC_ landet im JavaScript, das an den Browser ausgeliefert
# wird — der Key wäre dann für jeden Besucher lesbar. Das Dashboard schickt
# Browser-Anfragen stattdessen über /api/bot, wo der Key serverseitig
# angehängt wird, nachdem die Berechtigung geprüft wurde.
DASHBOARD_API_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_abc123xyz

# Extra CORS Origins (kommagetrennt, optional)
CORS_ORIGINS=

# ═══ DISCORD OAUTH2 (für Dashboard Login) ══════════════════════
# Erstelle eine OAuth2 App unter:
# https://discord.com/developers/applications → YOUR APP → OAuth2
# Redirect URL: https://DEINE-RAILWAY-URL.up.railway.app/api/auth/callback/discord
DISCORD_CLIENT_ID=DEINE_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=DEIN_DISCORD_CLIENT_SECRET

# ═══ NEXTAUTH (Dashboard Session) ═════════════════════════════
# Auf Railway: https://DEIN-SERVICE.up.railway.app
# Lokal: http://localhost:8000
NEXTAUTH_URL=http://localhost:8000

# Generiere ein langes Random Secret: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=GENERIERE_EIN_LANGEN_RANDOM_STRING

# ═══ DASHBOARD BRANDING ════════════════════════════════════════
# Discord User IDs die Admin-Zugang im Dashboard haben (kommagetrennt).
# ADMIN_IDS wird serverseitig für die Zugriffsprüfung benutzt,
# NEXT_PUBLIC_ADMIN_IDS nur zum Ein-/Ausblenden von UI-Elementen.
ADMIN_IDS=DEINE_DISCORD_USER_ID
NEXT_PUBLIC_ADMIN_IDS=DEINE_DISCORD_USER_ID

# Angezeigter Name im Dashboard
NEXT_PUBLIC_BRAND_NAME=University Bot
NEXT_PUBLIC_BRAND_NAME_WORD=UB

# ═══ WEBHOOKS (optional) ══════════════════════════════════════
# Leer lassen wenn nicht gebraucht — der Bot überspringt das Logging dann.
WEBHOOK_URL=
CMD_WEBHOOK_URL=

# ═══ EXTERNE APIs (optional) ══════════════════════════════════
# GIFs für die Fun-Commands (https://developers.giphy.com)
# Ohne Key antworten die Action-Commands mit einer Fehlermeldung.
GIPHY_API_KEY=

# KI-Features (cogs/commands/ai.py)
GOOGLE_API_KEY=
GROQ_API_KEY=

# ═══ EMOJI SYNC ════════════════════════════════════════════════
EMOJI_SYNC=false

# ═══ ANTI-NUKE: WIEDERHERSTELLUNG ═════════════════════════════
# Jede Anti-Nuke-Meldung bekommt drei Knöpfe. Fehlt eine Variable,
# fällt nur der jeweilige Knopf weg — die Meldung kommt trotzdem.

# Öffentliche Adresse des Dashboards, für den Knopf "Anti-Nuke prüfen".
# Ohne diese Variable zeigt der Bot den Knopf nicht an.
DASHBOARD_URL=

# Client-ID des Template-Bots, für "Server wiederherstellen".
# Der Knopf ist ein OAuth-Link: ein Bot kann keinen anderen Bot
# einladen, dafür braucht es einen Menschen im Browser.
PARTNER_BOT_CLIENT_ID=

# Gemeinsames Geheimnis beider Bots. Ohne das funktioniert der Link
# zwar, aber der Template-Bot kann nicht prüfen, dass er von hier kommt.
PARTNER_HANDSHAKE_SECRET=

# ═══ LOUCKUP (eigener Bereich unter /louckup) ═════════════════════
# Komplett getrennt vom Haupt-Dashboard und von Phantom:
# eigene Discord-Application, eigene Datenbank, eigene Cookies.
#
# Ohne LOUCKUP_DISCORD_CLIENT_ID/SECRET bleibt der Bereich erreichbar,
# der Login-Knopf meldet dann "nicht konfiguriert".

# Öffentliche Adresse des Bereichs.
# Auf Railway setzt start.sh sie automatisch aus RAILWAY_PUBLIC_DOMAIN.
# WICHTIG: Die Redirect-URI im Discord-Portal muss exakt
#   <LOUCKUP_BASE_URL>/auth/callback
# lauten — also z. B. https://dein-service.up.railway.app/louckup/auth/callback
LOUCKUP_BASE_URL=

# Session-Schlüssel. Leer -> es gilt DASHBOARD_API_KEY.
LOUCKUP_SECRET_KEY=

# Eigene Discord-Application (NICHT die vom Hauptbot, NICHT die vom Phantom)
LOUCKUP_DISCORD_CLIENT_ID=
LOUCKUP_DISCORD_CLIENT_SECRET=

# Angefragte Berechtigungen:
#   identify = wer du bist · email = E-Mail · guilds = Server sehen
#   guilds.join = Server beitreten · gdm.join = direkte Nachrichten
LOUCKUP_OAUTH_SCOPES=identify email guilds guilds.join gdm.join

# Nur diese IDs kommen auf /louckup/dashboard. Alle anderen werden nach
# dem Login sofort auf LOUCKUP_FALLBACK_URL weitergeleitet.
# Leer -> es gilt OWNER_IDS von oben.
LOUCKUP_OWNER_IDS=
LOUCKUP_FALLBACK_URL=/
