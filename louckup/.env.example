# ╔══════════════════════════════════════════════════════════════╗
# ║  Louckup — eigene Konfiguration (Bereich unter /louckup)      ║
# ║                                                              ║
# ║  Eigene Discord-Application. NICHT die vom Hauptbot und      ║
# ║  NICHT die vom Phantom — Louckup ist komplett getrennt.      ║
# ╚══════════════════════════════════════════════════════════════╝

# Öffentliche Adresse des Bereichs. Auf Railway: https://<deine-url>/louckup
# Wichtig: die Redirect-URI im Discord-Portal muss exakt
#   <LOUCKUP_BASE_URL>/auth/callback
# lauten.
LOUCKUP_BASE_URL=http://127.0.0.1:8080/louckup
LOUCKUP_COOKIE_PATH=/louckup

# Session-Schlüssel. Frei wählbar, aber geheim und stabil über Neustarts.
# Fehlt er, wird DASHBOARD_API_KEY benutzt; fehlt auch der, sind Sessions
# nur zum Entwickeln gültig (die Loginseite weist darauf hin).
LOUCKUP_SECRET_KEY=

# ── Discord OAuth2 (eigene Application) ──────────────────────────
LOUCKUP_DISCORD_CLIENT_ID=
LOUCKUP_DISCORD_CLIENT_SECRET=

# Angefragte Berechtigungen:
#   identify     wer du bist
#   email        E-Mail-Adresse
#   guilds       Server sehen
#   guilds.join  dich in einen Server holen
#   gdm.join     direkte Nachrichten
LOUCKUP_OAUTH_SCOPES=identify email guilds guilds.join gdm.join

# ── Zugriff ──────────────────────────────────────────────────────
# Nur diese IDs erreichen /louckup/dashboard. Alle anderen werden nach
# dem Login sofort auf LOUCKUP_FALLBACK_URL weitergeleitet.
# Leer -> es gilt OWNER_IDS aus der Hauptkonfiguration.
LOUCKUP_OWNER_IDS=
LOUCKUP_FALLBACK_URL=/

# ── Adressen ─────────────────────────────────────────────────────
# Mit jeder Anmeldung wird die Adresse festgehalten, von der sie kam.
# So bleibt nachvollziehbar, von wo der Bereich benutzt wird. Nach so
# vielen Tagen wird sie entfernt (0 = nie aufraeumen).
LOUCKUP_IP_AUFBEWAHREN_TAGE=90

# Wie viele Ortsabfragen pro Minute von einer Adresse aus erlaubt
# sind und wie lange eine Abfrage auf Antwort wartet (Sekunden).
LOUCKUP_IP_SUCHEN_LIMIT=30
LOUCKUP_IP_ZEITLIMIT=8.0

# ── Optik & Betrieb ──────────────────────────────────────────────
LOUCKUP_BRAND_NAME=Louckup
LOUCKUP_DB_PATH=data/louckup.db
# Nur relevant für den Standalone-Start (python run_louckup.py)
LOUCKUP_PORT=8788
