#!/usr/bin/env python3
"""Reject staged Stripe secret keys without ever printing their values."""
import re
import subprocess
import sys

pattern = re.compile(rb"(?:sk|rk)_(?:test|live)_[A-Za-z0-9]{24,}")
paths = subprocess.check_output(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"]).split(b"\0")
blocked = []
for path in filter(None, paths):
    content = subprocess.check_output(["git", "show", b":" + path])
    if pattern.search(content):
        blocked.append(path.decode("utf-8", "replace"))
if blocked:
    for path in blocked:
        print(f"Stripe secret key detected in staged file {path!r}. Remove and rotate it; use secure environment settings.", file=sys.stderr)
    sys.exit(1)
