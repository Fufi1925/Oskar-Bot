# Der Schluessel, mit dem die Zugangscodes der Community-Vorlagen
# verschluesselt werden. Er wird beim ersten Start neben der Datenbank
# angelegt und gehoert genauso wenig ins Repo wie ein Token -- wer ihn
# hat, kann jeden gespeicherten Code lesen.
db/template_secret.key
*.key

# Build
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Archives
*.tar
*.tar.gz
*.zip

# Large assets (optional - uncomment if needed)
# bot/assets/*.png
# bot/assets/*.ttf

# SQLite journals / write-ahead logs
*.db-journal
*.db-wal
*.db-shm
db/backups/

# Phantom local secrets/runtime
phantom/.env
phantom/.venv/
phantom/data/*.db
phantom/**/__pycache__/

# Louckup local secrets/runtime
# .env muss ignoriert bleiben: dort stehen die OAuth-Daten der eigenen
# Discord-Application und der Session-Schluessel.
louckup/.env
louckup/.venv/
louckup/data/*.db
louckup/**/__pycache__/
